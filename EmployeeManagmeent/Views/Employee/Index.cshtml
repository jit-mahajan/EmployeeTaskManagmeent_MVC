@model EmployeeManagmeent.ViewModels.EmployeeListViewModel

@{
    ViewData["Title"] = "Employees";
}

<div class="container">

    <div class="page-header">

        <div>
            <h1 class="page-title">
                <i class="bi bi-people-fill me-2"></i>
                Employees
            </h1>

            <p class="page-subtitle">
                Manage employees and their information
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-lg me-1"></i>
            Add Employee

        </a>

    </div>


    <div class="modern-card">

        <div class="modern-card-header">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    Employee List
                </h5>

                <span class="text-muted">
                    @Model.Pagination.TotalItems employees
                </span>

            </div>

        </div>


        @if (Model.Employees != null && Model.Employees.Any())
        {
            <div class="table-responsive">

                <table class="table modern-table">

                    <thead>
                        <tr>

                            <th>Employee</th>

                            <th>Email</th>

                            <th>Department</th>

                            <th>Status</th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>
                    </thead>


                    <tbody>

                        @foreach (var employee in Model.Employees)
                        {
                            <tr>

                                <td>

                                    <div class="d-flex align-items-center">

                                        <div class="employee-avatar me-3">

                                            @if (!string.IsNullOrEmpty(employee.Name))
                                            {
                                                @employee.Name.Substring(0, 1).ToUpper()
                                            }
                                            else
                                            {
                                                <span>?</span>
                                            }

                                        </div>

                                        <div>

                                            <div class="fw-semibold">
                                                @employee.Name
                                            </div>

                                            <small class="text-muted">
                                                Employee #@employee.Id
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <td>
                                    @employee.Email
                                </td>


                                <td>

                                    <span class="badge text-bg-light">
                                        @employee.Department
                                    </span>

                                </td>


                                <td>

                                    @if (employee.IsActive)
                                    {
                                        <span class="status-badge status-active">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Inactive
                                        </span>
                                    }

                                </td>


                                <td class="text-end">

                                    <div class="btn-group">

                                        <a asp-action="Details" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-primary"title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit" asp-route-id="@employee.Id"  class="btn btn-sm btn-outline-secondary"  title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="Delete" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            @if (Model.Pagination.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center p-3 border-top">

                    <div class="text-muted small">

                        Page
                        <strong>  @Model.Pagination.CurrentPage </strong>
                        of
                        <strong> @Model.Pagination.TotalPages </strong>

                    </div>


                    <nav aria-label="Employee pagination">

                        <ul class="pagination mb-0">

                            <li class="page-item
                                        @(Model.Pagination.HasPreviousPage ? "" : "disabled")">

                                @if (Model.Pagination.HasPreviousPage)
                                {
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@(Model.Pagination.CurrentPage - 1)"
                                       asp-route-pageSize="@Model.Pagination.PageSize">

                                        <i class="bi bi-chevron-left"></i>
                                        Previous

                                    </a>
                                }
                                else
                                {
                                    <span class="page-link">

                                        <i class="bi bi-chevron-left"></i>
                                        Previous

                                    </span>
                                }

                            </li>

                            @for (int pageNumber = 1;
                                                pageNumber <= Model.Pagination.TotalPages;
                                                pageNumber++)
                            {
                                <li class="page-item
                                                @(pageNumber == Model.Pagination.CurrentPage ? "active" : "")">

                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@pageNumber"
                                       asp-route-pageSize="@Model.Pagination.PageSize">

                                        @pageNumber

                                    </a>

                                </li>
                            }

                            <li class="page-item
                                        @(Model.Pagination.HasNextPage ? "" : "disabled")">

                                @if (Model.Pagination.HasNextPage)
                                {
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@(Model.Pagination.CurrentPage + 1)"
                                       asp-route-pageSize="@Model.Pagination.PageSize">

                                        Next
                                        <i class="bi bi-chevron-right"></i>

                                    </a>
                                }
                                else
                                {
                                    <span class="page-link">

                                        Next
                                        <i class="bi bi-chevron-right"></i>

                                    </span>
                                }

                            </li>

                        </ul>

                    </nav>

                </div>
            }
        }
        else
        {
            <div class="text-center p-5">

                <i class="bi bi-people empty-icon" style="font-size: 48px;"></i>

                <h5 class="mt-3">No employees found</h5>

                <p class="text-muted"> Start by adding your first employee. </p>

                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>
                    Add Employee
                </a>

            </div>
        }

    </div>

</div>