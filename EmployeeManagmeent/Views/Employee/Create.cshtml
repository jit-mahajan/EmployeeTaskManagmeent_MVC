@model EmployeeManagmeent.ViewModels.EmployeeViewModel

@{
    ViewData["Title"] = "Create Employee";
}

<div class="container">

    <div class="page-header">

        <div>
            <h1 class="page-title">
                <i class="bi bi-person-plus-fill me-2"></i>
                Create Employee
            </h1>

            <p class="page-subtitle">
                Add a new employee to the organization
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-light">

            <i class="bi bi-arrow-left me-1"></i>
            Back

        </a>

    </div>


    <div class="modern-card">

        <div class="modern-form-card">

            <form asp-action="Create"  method="post"class="employee-form">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Name" class="form-label"> Employee Name </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-person"></i>
                            </span>

                            <input asp-for="Name" class="form-control" placeholder="Enter employee name" />

                        </div>

                        <span asp-validation-for="Name"  class="text-danger"> </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Email" class="form-label">Email Address</label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-envelope"></i>
                            </span>

                            <input asp-for="Email"  type="email" class="form-control" placeholder="employee@example.com" />
                        </div>

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Department"  class="form-label">Department </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-building"></i>
                            </span>

                            <input asp-for="Department"  class="form-control"  placeholder="Enter department" />

                        </div>

                        <span asp-validation-for="Department" class="text-danger"> </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label class="form-label">  Employee Status </label>

                        <div class="form-check form-switch mt-2">

                            <input asp-for="IsActive" class="form-check-input" role="switch" />

                            <label asp-for="IsActive" class="form-check-label">Active Employee</label>

                        </div>

                    </div>

                </div>


                <hr class="my-4" />


                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index" class="btn btn-light"> Cancel </a>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>
                        Save Employee

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}