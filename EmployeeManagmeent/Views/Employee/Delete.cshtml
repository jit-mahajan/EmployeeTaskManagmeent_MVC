@model EmployeeViewModel

@{
    ViewData["Title"] = "Delete Employee";
}

<h2>Delete Employee</h2>

<div class="alert alert-danger"> Are you sure you want to delete this employee?</div>

<div class="card mb-3">

    <div class="card-body">
        <p> <strong>Name:</strong> @Model.Name</p>
        <p>  <strong>Email:</strong>  @Model.Email</p>
        <p> <strong>Department:</strong> @Model.Department</p>
    </div>

</div>

<form asp-action="DeleteConfirmed"asp-route-id="@Model.Id" method="post">

    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger"> Delete </button>

    <a asp-action="Index" class="btn btn-secondary"> Cancel</a>

</form>