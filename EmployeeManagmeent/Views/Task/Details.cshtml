@model TaskDetailsViewModel

@{
    ViewData["Title"] = "Task Details";
}

<h2>Task Details</h2>

<div class="card">

    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">Title</dt>

            <dd class="col-sm-9">@Model.Title </dd>

            <dt class="col-sm-3">Description</dt>

            <dd class="col-sm-9">@Model.Description </dd>

            <dt class="col-sm-3">Employee </dt>

            <dd class="col-sm-9">@Model.EmployeeName</dd>

            <dt class="col-sm-3">Status </dt>

            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Due Date</dt>

            <dd class="col-sm-9">@Model.DueDate.ToString("dd-MM-yyyy") </dd>

            <dt class="col-sm-3">Created Date</dt>

            <dd class="col-sm-9"> @Model.CreatedDate.ToString("dd-MM-yyyy")</dd>

        </dl>

    </div>

</div>

<div class="mt-3">

    <a asp-action="Edit" asp-route-id="@Model.Id"  class="btn btn-warning">Edit</a>

    <a asp-action="Index"  class="btn btn-secondary">Back</a>

</div>